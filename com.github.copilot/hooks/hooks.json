{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "exec": "${PLUGIN_ROOT}/windows-helper/bin/copilot-notify",
        "args": ["--hook", "activity", "sessionStart"],
        "timeoutSec": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "exec": "${PLUGIN_ROOT}/windows-helper/bin/copilot-notify",
        "args": ["--hook", "activity", "userPromptSubmitted"],
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "exec": "${PLUGIN_ROOT}/windows-helper/bin/copilot-notify",
        "args": ["--hook", "activity", "sessionEnd"],
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "exec": "${PLUGIN_ROOT}/windows-helper/bin/copilot-notify",
        "args": ["--hook", "notify", "agentStop"],
        "timeoutSec": 15
      },
      {
        "type": "command",
        "exec": "${PLUGIN_ROOT}/windows-helper/bin/copilot-notify",
        "args": ["--hook", "activity", "agentStop"],
        "timeoutSec": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "exec": "${PLUGIN_ROOT}/windows-helper/bin/copilot-notify",
        "args": ["--hook", "notify", "subagentStop"],
        "timeoutSec": 15
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog",
        "exec": "${PLUGIN_ROOT}/windows-helper/bin/copilot-notify",
        "args": ["--hook", "notify", "notification"],
        "timeoutSec": 15
      }
    ]
  }
}
