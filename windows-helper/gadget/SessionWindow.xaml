<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot Sessions" Width="900" Height="530" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="#10151D" Foreground="#ECF1F7"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowSurface" Color="#10151D"/>
    <SolidColorBrush x:Key="PanelSurface" Color="#161D28"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#181F2B"/>
    <SolidColorBrush x:Key="RowSurface" Color="#161D28"/>
    <SolidColorBrush x:Key="HoverSurface" Color="#1C2838"/>
    <SolidColorBrush x:Key="SelectedSurface" Color="#22364A"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#2A3545"/>
    <SolidColorBrush x:Key="RowBorder" Color="#222D3C"/>
    <SolidColorBrush x:Key="BusySurface" Color="#17283B"/>
    <SolidColorBrush x:Key="AttentionSurface" Color="#30291E"/>
    <SolidColorBrush x:Key="DoneSurface" Color="#1A302D"/>
    <SolidColorBrush x:Key="PopupSurface" Color="#F21B2533"/>
    <SolidColorBrush x:Key="PopupHoverSurface" Color="#F231465E"/>
    <SolidColorBrush x:Key="PopupSelectedSurface" Color="#F21B3B3C"/>
    <SolidColorBrush x:Key="PopupBorder" Color="#CC43546A"/>
    <Visibility x:Key="DetailVisibility">Visible</Visibility>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SessionRowHeight">70</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SmallFontSize">11</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="HeadingFontSize">25</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SummaryFontSize">24</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="EmptyTitleFontSize">15</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="EmptyIconFontSize">30</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib"
                   x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">14</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib"
                   x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">14</System:Double>
    <Thickness x:Key="CellPadding">18,0</Thickness>
    <Thickness x:Key="HeaderPadding">18,13</Thickness>
    <SolidColorBrush x:Key="Muted" Color="#91A0B5"/>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent" Padding="3">
              <Border x:Name="ThumbSurface" Background="#43546A" CornerRadius="4"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbSurface" Property="Background" Value="#6A839C"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface" Property="Background" Value="#74D9C7"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ThumbSurface" Property="Background" Value="#293342"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Background" Value="#161D28"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="7">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.Resources>
                  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib"
                                 x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</System:Double>
                  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib"
                                 x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</System:Double>
                </Track.Resources>
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PageBefore" Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PageAfter" Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="PageBefore" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="PageAfter" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="14"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#222D3E"/>
      <Setter Property="Foreground" Value="#ECF1F7"/>
      <Setter Property="BorderBrush" Value="#364459"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="#91A0B5"/>
      <Setter Property="Background" Value="{DynamicResource HeaderSurface}"/>
      <Setter Property="Padding" Value="{DynamicResource HeaderPadding}"/>
      <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border x:Name="Surface" Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource SurfaceBorder}"
                      BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter VerticalAlignment="Center"/>
                  <TextBlock x:Name="Arrow" Text="" Margin="7,0,0,0" Foreground="#74D9C7"/>
                </StackPanel>
              </Border>
              <Thumb x:Name="PART_LeftHeaderGripper" Width="8" HorizontalAlignment="Left"
                     Cursor="SizeWE" Background="Transparent">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Width="2" HorizontalAlignment="Left" Background="Transparent"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Grip" Property="Background" Value="#86E3D1"/>
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="Grip" Property="Background" Value="#B9FFF0"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
              <Thumb x:Name="PART_RightHeaderGripper" Width="8" HorizontalAlignment="Right"
                     Cursor="SizeWE" Background="Transparent">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Width="2" HorizontalAlignment="Right" Background="Transparent"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Grip" Property="Background" Value="#86E3D1"/>
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="Grip" Property="Background" Value="#B9FFF0"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#243045"/>
                <Setter Property="Foreground" Value="#ECF1F7"/>
              </Trigger>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="Arrow" Property="Text" Value="&#x2191;"/>
              </Trigger>
              <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="Arrow" Property="Text" Value="&#x2193;"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="{DynamicResource CellPadding}"/>
      <Setter Property="Foreground" Value="#ECF1F7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource RowSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RowBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="MinHeight" Value="{DynamicResource SessionRowHeight}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverSurface}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedSurface}"/>
          <Setter Property="BorderBrush" Value="#3F8D94"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PinStyle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#B4C1D1"/>
      <Setter Property="Background" Value="#1B2533"/>
      <Setter Property="BorderBrush" Value="#334156"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="PinSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PinSurface" Property="Background" Value="#29384B"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PinSurface" Property="Background" Value="#1B3B3C"/>
                <Setter TargetName="PinSurface" Property="BorderBrush" Value="#58B7A6"/>
                <Setter Property="Foreground" Value="#86E3D1"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="PinSurface" Property="BorderBrush" Value="#86E3D1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ReadButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#223245"/>
      <Setter Property="Foreground" Value="#D0DFEC"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ReadSurface" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" CornerRadius="5" BorderThickness="1"
                    BorderBrush="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ReadSurface" Property="Background" Value="#31465E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ReadSurface" Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#77899F"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ReadSurface" Property="BorderBrush" Value="#86E3D1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AppearanceItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="#ECF1F7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ChoiceCheck" Text="&#x2713;" Foreground="#86E3D1" Visibility="Hidden"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ChoiceCheck" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuSurface" Property="Background" Value="#29384B"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="MenuSurface" Property="BorderBrush" Value="#86E3D1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#77899F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FontComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#ECF1F7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PopupHoverSurface}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PopupSelectedSurface}"/>
                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#5886E3D1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FontComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#ECF1F7"/>
      <Setter Property="Background" Value="#223245"/>
      <Setter Property="BorderBrush" Value="#43546A"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleSurface" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center" TextElement.Foreground="#ECF1F7"/>
                        <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;"
                                   Foreground="#91A0B5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ToggleSurface" Property="Background" Value="#2A3B50"/>
                        <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#63809E"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#86E3D1"/>
                        <Setter TargetName="ToggleSurface" Property="Background" Value="#273A4D"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownToggle}"
                     IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"
                     PopupAnimation="Fade">
                <Border x:Name="DropDownSurface" MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,5,0,0"
                        Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource PopupBorder}"
                        BorderThickness="1" CornerRadius="7" Padding="5">
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.5"/>
                  </Border.Effect>
                  <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#86E3D1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource WindowSurface}">
  <Grid x:Name="RootLayout" Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid x:Name="HeaderLayout" Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="BrandIcon" Width="42" Height="42" Margin="0,0,14,0">
        <Image x:Name="AppLogo" Stretch="Uniform"/>
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="Heading" Text="Sessions" FontSize="{DynamicResource HeadingFontSize}"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Your agents, across Windows and WSL" Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{DynamicResource DetailVisibility}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <ToggleButton x:Name="Compact" Style="{StaticResource PinStyle}" Margin="0,0,8,0"
                    Content="Compact" ToolTip="Switch between compact and comfortable layouts"
                    AutomationProperties.Name="Compact layout"/>
      <ToggleButton x:Name="Pin" Style="{StaticResource PinStyle}"
                    VerticalAlignment="Center" ToolTip="Keep this window above other apps"
                    AutomationProperties.Name="Always on top" Content="Always on top"/>
      <Button x:Name="AppearanceButton" Style="{StaticResource ReadButtonStyle}" Width="34" Height="34"
              Margin="8,0,0,0" Padding="8" FontFamily="Segoe MDL2 Assets" Content="&#xE713;"
              ToolTip="Appearance" AutomationProperties.Name="Appearance" AutomationProperties.AutomationId="AppearanceButton">
        <Button.ContextMenu>
          <ContextMenu x:Name="AppearanceMenu" Background="{DynamicResource PopupSurface}" Foreground="#ECF1F7"
                       BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" Padding="6"
                       Width="330" HorizontalOffset="-296"
                       FontFamily="Segoe UI" FontSize="13" Placement="Bottom"
                       KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Appearance settings">
            <ContextMenu.Template>
              <ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.55"/>
                  </Border.Effect>
                  <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </ScrollViewer>
                </Border>
              </ControlTemplate>
            </ContextMenu.Template>
            <MenuItem x:Name="AppearanceAuto" Header="_Auto" Tag="Auto" IsCheckable="True"
                      Style="{StaticResource AppearanceItemStyle}" AutomationProperties.AutomationId="AppearanceAuto" AutomationProperties.Name="Auto"
                      ToolTip="Automatic: Acrylic locally when available; plain translucency in remote sessions"/>
            <MenuItem x:Name="AppearanceAcrylic" Header="A_crylic" Tag="Acrylic" IsCheckable="True"
                      Style="{StaticResource AppearanceItemStyle}" AutomationProperties.AutomationId="AppearanceAcrylic" AutomationProperties.Name="Acrylic"
                      ToolTip="Request native Acrylic, even remotely. Windows may render it solid; unsupported APIs use plain translucency."/>
            <MenuItem x:Name="AppearanceTranslucent" Header="_Translucent" Tag="Translucent" IsCheckable="True"
                      Style="{StaticResource AppearanceItemStyle}" AutomationProperties.AutomationId="AppearanceTranslucent" AutomationProperties.Name="Translucent"
                      ToolTip="Plain uniform translucency, including text and title bar; no blur"/>
            <MenuItem x:Name="AppearanceSolid" Header="_Solid" Tag="Solid" IsCheckable="True"
                      Style="{StaticResource AppearanceItemStyle}" AutomationProperties.AutomationId="AppearanceSolid" AutomationProperties.Name="Solid"
                      ToolTip="Fully opaque dark appearance"/>
            <Separator Background="#334156" Margin="8,4"/>
            <MenuItem Style="{StaticResource AppearanceItemStyle}" StaysOpenOnClick="True" Focusable="False">
              <MenuItem.Header>
                <StackPanel Width="210">
                  <TextBlock x:Name="OpacityLabel" Text="Translucent opacity: 90%" Margin="0,0,0,6"/>
                  <Slider x:Name="AppearanceOpacity" Minimum="50" Maximum="100" Value="90"
                          TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                          Foreground="#86E3D1" Background="#334156"
                          AutomationProperties.Name="Translucent opacity percent"
                          AutomationProperties.AutomationId="AppearanceOpacity"
                          ToolTip="50–100%. Applies to plain translucency and automatic fallback, not Acrylic blur."/>
                  <TextBlock Text="Tab to adjust; Esc to close" FontSize="{DynamicResource SmallFontSize}"
                             Foreground="#91A0B5" Margin="0,5,0,0"/>
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
            <Separator Background="#334156" Margin="8,4"/>
            <MenuItem Style="{StaticResource AppearanceItemStyle}" StaysOpenOnClick="True" Focusable="False">
              <MenuItem.Header>
                <StackPanel Width="270">
                  <TextBlock Text="Font family" Margin="0,0,0,6"/>
                  <ComboBox x:Name="InterfaceFontFamily" MaxDropDownHeight="260"
                            IsTextSearchEnabled="True" Style="{StaticResource FontComboBoxStyle}"
                            ItemContainerStyle="{StaticResource FontComboBoxItemStyle}"
                            AutomationProperties.Name="Interface font family"
                            AutomationProperties.AutomationId="InterfaceFontFamily">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock x:Name="FontSizeLabel" Text="Font size: 13" Margin="0,10,0,6"/>
                  <Slider x:Name="InterfaceFontSize" Minimum="10" Maximum="18" Value="13"
                          TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                          Foreground="#86E3D1" Background="#334156"
                          AutomationProperties.Name="Interface font size"
                          AutomationProperties.AutomationId="InterfaceFontSize"
                          ToolTip="Base font size from 10 to 18. Headings and secondary text scale proportionally."/>
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
      </StackPanel>
    </Grid>
    <Grid x:Name="SummaryCards" Grid.Row="1" Margin="0,0,0,18" Visibility="{DynamicResource DetailVisibility}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource BusySurface}" CornerRadius="9" Padding="16,12" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="BusyCount" Text="0" FontSize="{DynamicResource SummaryFontSize}"
                     FontWeight="SemiBold" Foreground="#8EC5FF"/>
          <TextBlock Text="In progress" Foreground="#A7BED7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource AttentionSurface}" CornerRadius="9" Padding="16,12" Margin="4,0,4,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="AttentionCount" Text="0" FontSize="{DynamicResource SummaryFontSize}"
                     FontWeight="SemiBold" Foreground="#F3CF87"/>
          <TextBlock Text="Needs input" Foreground="#CBB999" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource DoneSurface}" CornerRadius="9" Padding="16,12" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="DoneCount" Text="0" FontSize="{DynamicResource SummaryFontSize}"
                     FontWeight="SemiBold" Foreground="#8CDBC0"/>
          <TextBlock Text="Done" Foreground="#A6C6BA" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" CornerRadius="10" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
            Background="{DynamicResource PanelSurface}" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="Sessions" Background="Transparent" BorderThickness="0"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeColumns="True"
                  CanUserSortColumns="True" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="None" RowHeaderWidth="0" HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="SESSION" SortMemberPath="Title" CanUserSort="True" Width="*" MinWidth="170">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding Cwd}">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Cwd}" FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{StaticResource Muted}"
                               Visibility="{DynamicResource DetailVisibility}"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ENVIRONMENT" SortMemberPath="Source" CanUserSort="True" Width="155">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" ToolTip="{Binding Source}">
                    <Path Width="12" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                          Stroke="#8DADC8" StrokeThickness="0.9" Stretch="Uniform">
                      <Path.Style>
                        <Style TargetType="Path">
                          <Setter Property="Data" Value="M0,0 H12 V10 H0 Z M3,3 L5,5 L3,7 M7,7 H9"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Source}" Value="Windows">
                              <Setter Property="Data" Value="M0,0 H5 V4 H0 Z M7,0 H12 V4 H7 Z M0,6 H5 V10 H0 Z M7,6 H12 V10 H7 Z"/>
                              <Setter Property="Fill" Value="#8DADC8"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding Source}" Foreground="#B6C7DC" TextTrimming="CharacterEllipsis"
                               MaxWidth="100"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="STATUS" SortMemberPath="StatusRank" CanUserSort="True" Width="156">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding StatusBackground}" CornerRadius="12"
                          Padding="10,5" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="5" Height="5" Fill="{Binding StatusForeground}" Margin="0,0,7,0"
                               VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}"
                                 FontSize="{DynamicResource SmallFontSize}"
                                 FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="ID" SortMemberPath="Id" Binding="{Binding ShortId}" Width="106">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
                  <Setter Property="Foreground" Value="#91A0B5"/>
                  <Setter Property="ToolTip" Value="{Binding Id}"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsHitTestVisible="False" Margin="12,40,12,0">
          <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" Foreground="#51657E"
                     FontSize="{DynamicResource EmptyIconFontSize}"
                     HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <TextBlock x:Name="EmptyTitle" Text="Connecting to your agents"
                     FontSize="{DynamicResource EmptyTitleFontSize}" FontWeight="SemiBold"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Open Copilot sessions will appear here." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="2,10,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Detail" Text="Click a column to sort" Foreground="{StaticResource Muted}"
                 FontSize="{DynamicResource SmallFontSize}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <Button x:Name="Forget" Grid.Column="1" Content="Forget" Style="{StaticResource ReadButtonStyle}"
              Margin="8,0,0,0" IsEnabled="False"
              ToolTip="Hide the selected session until new conversation activity"/>
      <Button x:Name="MarkAllRead" Grid.Column="2" Content="Mark all read" Style="{StaticResource ReadButtonStyle}"
              Margin="8,0,0,0" ToolTip="Clear all unread completion badges"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#72C9AF" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Connection" Text="Connecting" Foreground="{StaticResource Muted}"
                   FontSize="{DynamicResource SmallFontSize}"/>
      </StackPanel>
    </Grid>
    <Border x:Name="ErrorPanel" Grid.Row="4" Background="#33252B" CornerRadius="7"
            Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock x:Name="ErrorText" Foreground="#ECB4B9" TextWrapping="Wrap" MaxHeight="64"
                 TextTrimming="CharacterEllipsis" FontSize="{DynamicResource SmallFontSize}"/>
    </Border>
  </Grid>
  </Border>
</Window>
