{
  "lspServers": {
    "csharp": {
      "disabled": false,
      "command": "dotnet",
      "args": [
        "dnx",
        "roslyn-language-server@5.13.0-1.26514.10",
        "--",
        "--stdio",
        "--autoLoadProjects",
        "--telemetryLevel",
        "off"
      ],
      "env": {
        "DOTNET_ROOT": "${HOME}/.dotnet",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
      },
      "fileExtensions": {
        ".cs": "csharp"
      }
    }
  }
}
